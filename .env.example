# apps/server reads these (copy to apps/server/.env)
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Simulated events/sec per tenant at peak (0 = off), and WebSocket batch interval
SIM_RATE=30
WS_FLUSH_MS=50
CORS_ORIGIN=http://localhost:5173
# Behind a host's load balancer (Render, Fly, Railway): 1. Locally: 0
TRUST_PROXY=0
# Natural-language filters. Without a key, Pulse uses keyword matching instead.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5
AI_TIMEOUT_MS=12000
